{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "betterjira",
  "version": "0.1.0",
  "identifier": "com.leon.betterjira",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "betterjira",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 25
        },
        "label": "main",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwNDZFMzdBNjcyNTlBODEKUldTQm1pVm5ldU5HNEF5U3EraHBaRWtJV1JHc010VVRic2NHZm5yK2dVaENFdXRaaGgydW50VDcK",
      "endpoints": [
        "https://github.com/Leon-Achteresch/betterjira/releases/latest/download/latest.json"
      ]
    }
  }
}
